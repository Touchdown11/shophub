# ShopHub — staff portal
# This application is for staff only. Keep it off the search engines and out of
# the way if you would rather restrict access by IP.

Options -Indexes

<IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex, nofollow, noarchive"
    Header set Referrer-Policy "same-origin"
</IfModule>

<FilesMatch "\.(sqlite|log|sql)$">
    Require all denied
</FilesMatch>

# Uncomment (and set your office IP) to lock the whole portal to one network:
# <RequireAll>
#     Require ip 203.0.113.0/24
# </RequireAll>
